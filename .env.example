# Puerto del servidor Express
PORT=3001

# API Key de Google Gemini para el chat IA y evaluaciones
GEMINI_API_KEY="TU_API_KEY_AQUI"

# Secreto para firmar tokens JWT (cambiar en producción)
JWT_SECRET="cambiar_por_un_secreto_seguro"

# Origen permitido para CORS (frontend)
CORS_ORIGIN="http://localhost:3000"

# ─── Base de datos ──────────────────────────────────────────────

# Provider: "postgres" (producción/desarrollo) o "sqlite" (offline/demo)
# Si no se define, se auto-detecta según DATABASE_URL
DATABASE_PROVIDER="postgres"

# URL de conexión PostgreSQL (V2)
# Solo se usa si DATABASE_PROVIDER=postgres
DATABASE_URL="postgres://minamatch:minamatch_dev@localhost:5432/minamatch_v2"

# ─── Logging ─────────────────────────────────────────────────────
# Nivel de log: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# Por defecto: "debug" en desarrollo, "info" en producción
LOG_LEVEL="debug"

# ─── Frontend V2 API ────────────────────────────────────────────
# URL del backend V2. Por defecto apunta a localhost:3004 en desarrollo.
# En Railway/producción se define como la URL del backend V2.
VITE_API_URL="http://localhost:3004"
